# Execucao da API diretamente pelo Node.js no computador.
NODE_ENV=development
PORT=3000

# PostgreSQL principal da API JavaScript
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=livros_db
POSTGRES_USER=livros
POSTGRES_PASSWORD=livros_dev

# MySQL replica
MYSQL_HOST=localhost
MYSQL_PORT=3307
MYSQL_DATABASE=livros_db
MYSQL_USER=livros
MYSQL_PASSWORD=livros_dev

DB_CONNECT_TIMEOUT_MS=3000
HEALTH_TIMEOUT_MS=1000
REPLICATION_INTERVAL_MS=5000
