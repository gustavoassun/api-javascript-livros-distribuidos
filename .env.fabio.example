# Porta publicada pela API JavaScript no computador que executa o Docker.
API_JAVASCRIPT_PORT=3001

# Rede Docker compartilhada com API Java, API Python e bancos.
DOCKER_NETWORK=sistemas-distribuidos

# PostgreSQL principal da API JavaScript.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=livros
POSTGRES_USER=livros
POSTGRES_PASSWORD=livros

# MySQL usado como replica pela API JavaScript.
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=livros
MYSQL_USER=livros
MYSQL_PASSWORD=livros

DB_CONNECT_TIMEOUT_MS=3000
HEALTH_TIMEOUT_MS=1000
REPLICATION_INTERVAL_MS=5000
